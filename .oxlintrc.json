{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn", "import", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "options": { "typeAware": true },
  "env": { "browser": true, "es2024": true },
  "ignorePatterns": ["dist", "node_modules", "coverage"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "import/no-default-export": "error",
    "no-magic-numbers": [
      "error",
      {
        "ignore": [0, 1, -1],
        "ignoreArrayIndexes": true,
        "ignoreDefaultValues": true,
        "ignoreTypeIndexes": true,
        "ignoreNumericLiteralTypes": true,
        "enforceConst": true
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/testing/**"],
      "rules": { "no-magic-numbers": "off" }
    },
    {
      "files": ["*.config.{js,cjs,mjs,ts,cts,mts}"],
      "rules": { "import/no-default-export": "off", "no-magic-numbers": "off" }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features", "**/features/**"],
                "message": "shared cannot depend on features"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/features", "**/features/**"],
                "message": "inside a feature use relative imports; never the features/ path"
              },
              {
                "regex": "^(\\.\\./)+(tuner)(/|$)",
                "message": "a feature cannot import another feature"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/audio/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "message": "audio must stay framework-free" },
              {
                "name": "react-dom",
                "message": "audio must stay framework-free"
              }
            ],
            "patterns": [
              {
                "group": ["react/*", "react-dom/*"],
                "message": "audio must stay framework-free"
              },
              {
                "group": ["**/ui", "**/ui/**"],
                "message": "audio cannot depend on ui"
              },
              {
                "group": ["**/features", "**/features/**"],
                "message": "inside a feature use relative imports; never the features/ path"
              },
              {
                "regex": "^(\\.\\./)+(tuner)(/|$)",
                "message": "a feature cannot import another feature"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "react", "message": "core must stay framework-free" },
              {
                "name": "react-dom",
                "message": "core must stay framework-free"
              }
            ],
            "patterns": [
              {
                "group": ["react/*", "react-dom/*"],
                "message": "core must stay framework-free"
              },
              {
                "group": ["**/audio", "**/audio/**", "**/ui", "**/ui/**"],
                "message": "core cannot depend on audio or ui"
              },
              {
                "group": ["**/features", "**/features/**"],
                "message": "inside a feature use relative imports; never the features/ path"
              },
              {
                "regex": "^(\\.\\./)+(tuner)(/|$)",
                "message": "a feature cannot import another feature"
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "checkGlobalObject": true,
            "globalObjects": ["globalThis", "self", "window"],
            "globals": [
              {
                "name": "window",
                "message": "core must not use browser globals"
              },
              {
                "name": "document",
                "message": "core must not use browser globals"
              },
              {
                "name": "navigator",
                "message": "core must not use browser globals"
              },
              {
                "name": "AudioContext",
                "message": "core must not use browser globals"
              },
              {
                "name": "localStorage",
                "message": "core must not use browser globals"
              },
              {
                "name": "sessionStorage",
                "message": "core must not use browser globals"
              },
              {
                "name": "location",
                "message": "core must not use browser globals"
              }
            ]
          }
        ]
      }
    }
  ]
}
